<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap3 rescap">

  <!--
    Publisher must match the certificate the package is signed with. Visual Studio rewrites it
    when you pick a signing certificate under Package.appxmanifest > Packaging.
  -->
  <Identity
    Name="GrantRogers.WorldClockWidget"
    Publisher="CN=Grant Rogers"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>World Clock Widget</DisplayName>
    <PublisherDisplayName>Grant Rogers</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 11 22H2 introduced third-party widgets. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="World Clock Widget"
        Description="See the time in cities around the world from the Windows 11 Widgets Board."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Registers the executable as an out-of-process COM server the Widgets Board can activate. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="WorldClockWidget.exe" Arguments="-RegisterProcessAsComServer" DisplayName="World Clock Widget Provider">
              <com:Class Id="362D215B-9EDE-4946-AC8D-35CF85DDFAE9" DisplayName="World Clock Widget Provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Declares the widget(s) this package provides. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="World Clock Widget" Id="GrantRogers.WorldClockWidget" PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\StoreLogo.png" />
                </ProviderIcons>
                <Activation>
                  <!-- The app exports a COM class implementing IWidgetProvider. -->
                  <CreateInstance ClassId="362D215B-9EDE-4946-AC8D-35CF85DDFAE9" />
                </Activation>
                <Definitions>
                  <Definition Id="WorldClock_Widget"
                    DisplayName="World clock"
                    Description="See the time in cities around the world at a glance."
                    AllowMultiple="true"
                    IsCustomizable="true">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="ProviderAssets\WorldClock_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="ProviderAssets\WorldClock_Screenshot.png" DisplayAltText="World clock widget showing the time in four cities" />
                      </Screenshots>
                      <DarkMode>
                        <Icons>
                          <Icon Path="ProviderAssets\WorldClock_Icon.png" />
                        </Icons>
                        <Screenshots>
                          <Screenshot Path="ProviderAssets\WorldClock_Screenshot_Dark.png" DisplayAltText="World clock widget in dark mode" />
                        </Screenshots>
                      </DarkMode>
                      <LightMode>
                        <Icons>
                          <Icon Path="ProviderAssets\WorldClock_Icon.png" />
                        </Icons>
                        <Screenshots>
                          <Screenshot Path="ProviderAssets\WorldClock_Screenshot_Light.png" DisplayAltText="World clock widget in light mode" />
                        </Screenshots>
                      </LightMode>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
